# --- Groq (free) - script generation ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Edge-TTS (free, no key needed) - calm storyteller male voice ---
TTS_VOICE=en-US-EricNeural

# --- Python worker (faster-whisper) ---
PYTHON_BIN=python3

# --- YouTube Data API v3 (free) ---
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
YT_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob

# --- Telegram notifications (free) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Scheduler ---
PIPELINE_CRON=0 9 * * 1,3,5,6

# --- Safety: keep uploads private for the first week while you verify output ---
FIRST_WEEK_MODE=true

# --- Summary Short pipeline (new, separate feature - does not affect the story pipeline) ---
# Read-only YouTube Data API key for searching/discovering source videos (separate from YT_CLIENT_ID/SECRET which are for uploading)
YT_API_KEY=
# Voice used for the new English narration on Summary Shorts
SUMMARY_TTS_VOICE=en-US-EricNeural
# Optional path to a cookies.txt file if some source videos require login to download
YT_COOKIES_FILE=
# Cron schedule for scheduler-summary.js (only used if running locally instead of GitHub Actions)
SUMMARY_PIPELINE_CRON=0 10 * * *
